# ==========================================
# KONFIGURASI FIREBASE CLIENT (WAJIB)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# ISOLASI DATABASE & STORAGE KHUSUS SELEKSI
# ==========================================
NEXT_PUBLIC_SELEKSI_DATABASE_ID=pendaftaran-seleksi
NEXT_PUBLIC_SELEKSI_STORAGE_BUCKET=seleksi-solo-technopark

# ==========================================
# FIREBASE ADMIN SDK (SERVER-SIDE API ROUTES)
# Untuk deployment (Vercel/App Hosting), isi salah satu:
# 1. FIREBASE_SERVICE_ACCOUNT_KEY='{...json...}'
# 2. Atau kombinasi 3 variabel di bawah ini:
# ==========================================
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# GOOGLE AI STUDIO & KEAMANAN API (SERVER-SIDE ONLY)
# Wajib hanya gunakan varian *-lite (default: gemini-3.5-flash-lite)
# ==========================================
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_APP_ORIGIN=https://pendaftaran-seleksi.vercel.app
INTERNAL_API_SECRET=generate_64_char_hex_secret
CRON_SECRET=generate_64_char_hex_secret

# ==========================================
# NOTIFIKASI PELAMAR (OPSIONAL)
# ==========================================
RESEND_API_KEY=
MAIL_FROM="Panitia Seleksi <no-reply@solotechnopark.id>"
WEBHOOK_NOTIFY_URL=
